[
  {
    "id": "node-lab-flow",
    "type": "tab",
    "label": "Node Lab | synthetic temperature",
    "disabled": false,
    "info": "Public, bounded synthetic demonstration. No physical device, external action or live AI inference."
  },
  {
    "id": "truth-note",
    "type": "comment",
    "z": "node-lab-flow",
    "name": "SYNTHETIC ONLY: input -> validate -> 30 C threshold -> output",
    "info": "The public page sends only 22 C and 34 C. Invalid 99 C is rejected. Browser history remains per visitor.",
    "x": 530,
    "y": 80,
    "wires": []
  },
  {
    "id": "sample-http",
    "type": "http in",
    "z": "node-lab-flow",
    "name": "Bounded public sample",
    "url": "/api/sample",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 180,
    "y": 200,
    "wires": [["validate-sample"]]
  },
  {
    "id": "validate-sample",
    "type": "function",
    "z": "node-lab-flow",
    "name": "Allow 22 C or 34 C only",
    "func": "const origin = String(msg.req?.headers?.origin || '');\nconst allowedOrigin = env.get('NODE_LAB_ALLOWED_ORIGIN') || 'http://127.0.0.1:1880';\nconst raw = msg.payload && typeof msg.payload === 'object' ? msg.payload.temperature : undefined;\nconst temperature = Number(raw);\nmsg.headers = {'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store'};\nif (origin !== allowedOrigin) {\n    msg.statusCode = 403;\n    msg.payload = {error:'same-origin request required'};\n    return [null, msg];\n}\nif (!Number.isFinite(temperature) || ![22,34].includes(temperature)) {\n    msg.statusCode = 400;\n    msg.payload = {error:'sample must be exactly 22 or 34 degrees Celsius', accepted:false};\n    return [null, msg];\n}\nmsg.payload = temperature;\nmsg.topic = 'synthetic-temperature';\nreturn [msg, null];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 200,
    "wires": [["threshold-rule"], ["rejected-response"]]
  },
  {
    "id": "threshold-rule",
    "type": "function",
    "z": "node-lab-flow",
    "name": "Threshold at 30 C",
    "func": "const temperature = Number(msg.payload);\nconst alert = temperature >= 30;\nmsg.statusCode = 200;\nmsg.headers = {'Content-Type':'application/json; charset=utf-8','Cache-Control':'no-store'};\nmsg.payload = {\n    accepted:true,\n    temperature,\n    threshold:30,\n    status:alert ? 'HIGH TEMPERATURE' : 'NORMAL OPERATION',\n    source:'synthetic-demo',\n    sequence:alert ? 'alert' : 'normal'\n};\nnode.status({fill:alert ? 'red' : 'green',shape:'dot',text:temperature + ' C | ' + msg.payload.sequence});\nreturn msg.res ? [msg, null] : [null, msg];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 730,
    "y": 180,
    "wires": [["accepted-response"], ["private-debug"]]
  },
  {
    "id": "accepted-response",
    "type": "http response",
    "z": "node-lab-flow",
    "name": "Accepted JSON",
    "statusCode": "",
    "headers": {},
    "x": 990,
    "y": 140,
    "wires": []
  },
  {
